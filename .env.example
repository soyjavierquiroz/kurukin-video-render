# Local-only provider credentials. Copy to .env on the server.
# Never commit real values.

PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=

# Atlas is opt-in. It is used only by policies that explicitly list "atlas".
# MPT does not load a .env file implicitly; supply these as process environment values.
ATLAS_ENABLED=false
ATLAS_BASE_URL=http://127.0.0.1:18765
ATLAS_TIMEOUT_SECONDS=15

# Kurukin Asset Hub client. Keep API key empty in version control.
# ASSET_HUB_MATERIALIZED_ROOT defaults to /data/job-assets when empty.
ASSET_HUB_BASE_URL=
ASSET_HUB_API_KEY=
ASSET_HUB_MATERIALIZED_ROOT=

# Enables controlled prepare-only Pexels sourcing. Do not enable by default.
KURUKIN_ENABLE_PEXELS_SOURCE=
